<?xml version="1.0" encoding="utf-8"?>
<EuphoriaLabPreset format="1">
  <Name>My physics sets</Name>
  <Author>matt..</Author>
  <Description></Description>
  <ModVersion>1.4.0</ModVersion>
  <Tags>physics</Tags>
  <PhysicsSets>
    <Set task="CTaskNMShot" label="Shot_Base" enabled="true" priority="0">
      <Messages>
        <Item type="CNmMessage">
          <Name>setFallingReaction</Name>
          <Params>
            <Item type="CNmParameterBool">
              <Name>start</Name>
              <Value value="true" />
            </Item>
            <Item type="CNmParameterBool">
              <Name>handsAndKnees</Name>
              <Value value="true" />
            </Item>
          </Params>
          <ForceNewMessage value="false" />
          <TaskMessage value="false" />
        </Item>
        <Item type="CNmMessage">
          <Name>bodyBalance</Name>
          <Params>
            <Item type="CNmParameterBool">
              <Name>start</Name>
              <Value value="true" />
            </Item>
          </Params>
          <ForceNewMessage value="false" />
          <TaskMessage value="false" />
        </Item>
      </Messages>
    </Set>
  </PhysicsSets>
</EuphoriaLabPreset>